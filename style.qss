
QMainWindow {
    background-color: #222121;
}

QLabel[class="heading_true"] {
    color: blue;
    font-size: 13px;
}

QLabel[class="label"] {
    background-color: #3a3a3a;
    font-size: 50px;
    font-weight: bold;
    color: white;
}

QLabel[class="confidence"] {
    background-color: #3a3a3a;
    font-size: 10px;
    color: white;
}

QLabel[class="heading"] {
    color: red;
    font-size: 13px;
}

QLabel[class="webcam"] {
    background-color: #222121;
}


QLabel {
    background-color: #b8c5d1;
    font-size: 20px;
    font-weight: bold;
    color: black;
}

QPushButton {
    background-color: #3a3a3a;
    
    border: 2px solid #555;
    border-radius: 12px;
    padding: 15px;
    text-align: left;
    
}

QPushButton:hover {
    border: 2px solid #00c8ff;
    background-color: #444;
}

QPushButton:pressed {
    background-color: #2d2d2d;
}

QLineEdit {
    background-color: #dadeeb;
    border: 2px solid #555;
    border-radius: 8px;
    color: black;
    font-size: 13px;
    padding: 8px;
    min-height: 10px;
    

}